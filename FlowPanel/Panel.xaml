<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="zapretgui" Width="1210" Height="790" MinWidth="970" MinHeight="610"
        WindowStartupLocation="CenterScreen" Background="#000000" Foreground="#F5F5F5"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Muted" Color="#A7A7A7"/>
    <SolidColorBrush x:Key="Accent" Color="#F2F2F2"/>
    <LinearGradientBrush x:Key="GlassCard" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#D9202020" Offset="0"/>
      <GradientStop Color="#E00B0B0B" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassEdge" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#6C929292" Offset="0"/>
      <GradientStop Color="#2B2B2B" Offset=".47"/>
      <GradientStop Color="#171717" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassSelection" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#69808080" Offset="0"/>
      <GradientStop Color="#535A5A5A" Offset=".7"/>
      <GradientStop Color="#4F353535" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassButton" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#D3383838" Offset="0"/>
      <GradientStop Color="#C41E1E1E" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryGlass" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FFFFFF" Offset="0"/>
      <GradientStop Color="#F2F2F2" Offset="1"/>
    </LinearGradientBrush>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource GlassCard}"/>
      <Setter Property="BorderBrush" Value="{StaticResource GlassEdge}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="23"/>
      <Setter Property="Padding" Value="20"/>
    </Style>
    <Style x:Key="MutedText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="FontSize" Value="21"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#EEEEEE"/>
      <Setter Property="Background" Value="{StaticResource GlassButton}"/>
      <Setter Property="BorderBrush" Value="#383838"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="13,7"/>
      <Setter Property="Margin" Value="0,0,7,7"/>
      <Setter Property="MinHeight" Value="35"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="15" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="#F2F2F2"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="Opacity" Value=".74"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Surface" Property="Opacity" Value=".38"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="#F2F2F2"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource PrimaryGlass}"/>
      <Setter Property="Foreground" Value="#151515"/>
      <Setter Property="BorderBrush" Value="#F2F2F2"/>
    </Style>
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ScrollThumb" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="ScrollGrip" Background="#737373" CornerRadius="5" Margin="2"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ScrollGrip" Property="Background" Value="#B8B8B8"/>
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="ScrollGrip" Property="Background" Value="#EEEEEE"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <ControlTemplate x:Key="VerticalScroll" TargetType="ScrollBar">
      <Border Background="#202020" CornerRadius="6">
        <Track x:Name="PART_Track" IsDirectionReversed="True">
          <Track.DecreaseRepeatButton>
            <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPage}"/>
          </Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
          <Track.IncreaseRepeatButton>
            <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPage}"/>
          </Track.IncreaseRepeatButton>
        </Track>
      </Border>
    </ControlTemplate>
    <ControlTemplate x:Key="HorizontalScroll" TargetType="ScrollBar">
      <Border Background="#202020" CornerRadius="6">
        <Track x:Name="PART_Track">
          <Track.DecreaseRepeatButton>
            <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollPage}"/>
          </Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
          <Track.IncreaseRepeatButton>
            <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollPage}"/>
          </Track.IncreaseRepeatButton>
        </Track>
      </Border>
    </ControlTemplate>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="12"/>
      <Setter Property="MinWidth" Value="12"/>
      <Setter Property="Template" Value="{StaticResource VerticalScroll}"/>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="MinWidth" Value="0"/>
          <Setter Property="Height" Value="12"/>
          <Setter Property="MinHeight" Value="12"/>
          <Setter Property="Template" Value="{StaticResource HorizontalScroll}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="GlassSidebar" TargetType="TabControl">
      <Setter Property="TabStripPlacement" Value="Left"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Grid KeyboardNavigation.TabNavigation="Local">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="201"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border CornerRadius="23" Padding="8,9,8,11" Margin="0,9,16,7" VerticalAlignment="Top"
                      Background="{StaticResource GlassCard}" BorderBrush="{StaticResource GlassEdge}" BorderThickness="1">
                <StackPanel IsItemsHost="True" Orientation="Vertical" KeyboardNavigation.DirectionalNavigation="Cycle"
                            KeyboardNavigation.TabIndex="1"/>
              </Border>
              <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="1" ContentSource="SelectedContent"
                                KeyboardNavigation.TabIndex="2"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#CACACA"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="11,12"/>
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="TabSurface" CornerRadius="16" Background="Transparent" BorderBrush="Transparent"
                    BorderThickness="1" Padding="{TemplateBinding Padding}">
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="15" Text="{TemplateBinding Tag}" Margin="0,0,9,0"
                           VerticalAlignment="Center"/>
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TabSurface" Property="Background" Value="#26A0A0A0"/>
                <Setter TargetName="TabSurface" Property="BorderBrush" Value="#555555"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TabSurface" Property="Background" Value="{StaticResource GlassSelection}"/>
                <Setter TargetName="TabSurface" Property="BorderBrush" Value="#79E5E5E5"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="TabSurface" Property="BorderBrush" Value="#F2F2F2"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#F5F5F5"/>
      <Setter Property="Background" Value="#161616"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="ItemSurface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemSurface" Property="Background" Value="#3C3C3C"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#161616"/>
      <Setter Property="Foreground" Value="#F5F5F5"/>
      <Setter Property="Padding" Value="11,7"/>
      <Setter Property="MinHeight" Value="37"/>
      <Setter Property="Margin" Value="0,0,0,13"/>
      <Setter Property="MaxDropDownHeight" Value="280"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="OpenList" Focusable="False" Cursor="Hand" Foreground="{TemplateBinding Foreground}"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="SelectSurface" Background="#161616" BorderBrush="#474747" BorderThickness="1" CornerRadius="7">
                      <TextBlock Text="⌄" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,4"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="SelectSurface" Property="BorderBrush" Value="#F2F2F2"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,0,30,0"
                                Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
              <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}">
                <Border Background="#161616" BorderBrush="#474747" BorderThickness="1" Padding="1"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                  <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="OpenList" Property="Opacity" Value=".4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Border IsHitTestVisible="False">
      <Border.Background>
        <RadialGradientBrush Center=".16,.12" GradientOrigin=".08,.05" RadiusX=".88" RadiusY=".82">
          <GradientStop Color="#202020" Offset="0"/>
          <GradientStop Color="#0B0B0B" Offset=".55"/>
          <GradientStop Color="#000000" Offset="1"/>
        </RadialGradientBrush>
      </Border.Background>
    </Border>
    <Grid Margin="26,19,26,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel Margin="0,0,0,19" LastChildFill="False">
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
        <Image x:Name="BrandImage" Width="41" Height="41" Margin="0,0,11,0" RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock Text="zapretgui" FontSize="27" FontWeight="Bold" VerticalAlignment="Center"/>
      </StackPanel>
    </DockPanel>

    <TabControl x:Name="Tabs" Grid.Row="1" Style="{StaticResource GlassSidebar}">
      <TabItem Header="Статус" Tag="&#xE9D9;">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,9,4,7">
            <DockPanel Margin="0,0,0,14" LastChildFill="False">
              <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Работоспособность" FontSize="29" FontWeight="Bold"/>
                <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0" Text="Доступность сервисов и состояние запущенных утилит"/>
              </StackPanel>
              <Button x:Name="Refresh" Content="Обновить статус" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0" Style="{StaticResource Primary}"/>
            </DockPanel>
            <UniformGrid Columns="3" Margin="0,0,0,18">
              <Border Style="{StaticResource Card}" Margin="0,0,6,0">
                <StackPanel><TextBlock Text="YouTube" Style="{StaticResource Section}"/>
                  <TextBlock x:Name="YouTubeState" Text="Нет замера" Margin="0,12,0,0" FontSize="16" TextWrapping="Wrap"/>
                  <TextBlock x:Name="YouTubeDetail" Style="{StaticResource MutedText}" Text="HTTPS" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}" Margin="6,0">
                <StackPanel><TextBlock Text="Discord" Style="{StaticResource Section}"/>
                  <TextBlock x:Name="DiscordState" Text="Нет замера" Margin="0,12,0,0" FontSize="16" TextWrapping="Wrap"/>
                  <TextBlock x:Name="DiscordDetail" Style="{StaticResource MutedText}" Text="HTTPS API" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}" Margin="6,0,0,0">
                <StackPanel><TextBlock Text="Telegram" Style="{StaticResource Section}"/>
                  <TextBlock x:Name="TelegramState" Text="Нет замера" Margin="0,12,0,0" FontSize="16" TextWrapping="Wrap"/>
                  <TextBlock x:Name="TelegramDetail" Style="{StaticResource MutedText}" Text="Веб и локальный MTProto" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
            </UniformGrid>
            <TextBlock Text="Утилиты" Style="{StaticResource Section}" Margin="0,0,0,10"/>
            <UniformGrid Columns="2" Margin="0,0,0,14">
              <Border Style="{StaticResource Card}" Margin="0,0,6,0">
                <StackPanel>
                  <TextBlock Text="zapret" Style="{StaticResource Section}"/>
                  <TextBlock x:Name="ZapStatus" Text="Проверяю…" Margin="0,9,0,0" FontSize="15"/>
                  <TextBlock x:Name="ZapDetails" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}" Margin="6,0,0,0">
                <StackPanel>
                  <TextBlock Text="TG WS Proxy" Style="{StaticResource Section}"/>
                  <TextBlock x:Name="TgStatus" Text="Проверяю…" Margin="0,9,0,0" FontSize="15"/>
                  <TextBlock x:Name="TgDetails" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
            </UniformGrid>
            <TextBlock x:Name="LastCheck" Style="{StaticResource MutedText}" Text="Нажми «Обновить статус», чтобы проверить сервисы."/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Установка и тесты" Tag="&#xE896;">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,9,4,7">
            <DockPanel Margin="0,0,0,10" LastChildFill="False">
              <TextBlock DockPanel.Dock="Left" Text="Установка и тесты" FontSize="27" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,7"/>
              <WrapPanel DockPanel.Dock="Right">
                <Button x:Name="DownloadBoth" Content="Скачать обе утилиты" Style="{StaticResource Primary}"/>
                <Button x:Name="Updates" Content="Проверить обновления" Margin="0,0,0,7"/>
              </WrapPanel>
            </DockPanel>
            <UniformGrid Columns="2" Margin="0,0,0,12">
              <Border Style="{StaticResource Card}" Margin="0,0,6,0">
                <StackPanel>
                  <DockPanel LastChildFill="True" Margin="0,0,0,8">
                    <Button x:Name="DownloadZap" DockPanel.Dock="Right" Content="Скачать" Margin="0"/>
                    <TextBlock Text="zapret" Style="{StaticResource Section}" VerticalAlignment="Center"/>
                  </DockPanel>
                  <TextBlock Text="Стратегия" Style="{StaticResource MutedText}" Margin="0,0,0,5"/>
                  <ComboBox x:Name="ZapChoice" AutomationProperties.Name="Стратегия zapret"/>
                  <WrapPanel>
                    <Button x:Name="ZapTest" Content="Проверить конфиги"/>
                    <Button x:Name="ZapFolder" Content="Папка" ToolTip="Открыть папку конфигов"/>
                    <Button x:Name="ZapAuto" Content="Автовыбор и запуск" Style="{StaticResource Primary}"/>
                    <Button x:Name="ZapApply" Content="Применить"/>
                    <Button x:Name="ZapRestart" Content="Перезапустить"/>
                    <Button x:Name="ZapStop" Content="Остановить"/>
                  </WrapPanel>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}" Margin="6,0,0,0">
                <StackPanel>
                  <DockPanel LastChildFill="True" Margin="0,0,0,8">
                    <Button x:Name="DownloadTg" DockPanel.Dock="Right" Content="Скачать" Margin="0"/>
                    <TextBlock Text="TG WS Proxy" Style="{StaticResource Section}" VerticalAlignment="Center"/>
                  </DockPanel>
                  <TextBlock Text="Профиль прокси" Style="{StaticResource MutedText}" Margin="0,0,0,5"/>
                  <ComboBox x:Name="TgChoice" AutomationProperties.Name="Профиль TG WS Proxy"/>
                  <WrapPanel>
                    <Button x:Name="TgTest" Content="Проверить конфиги"/>
                    <Button x:Name="TgFolder" Content="Папка" ToolTip="Открыть папку конфигов"/>
                    <Button x:Name="TgAuto" Content="Автовыбор и запуск" Style="{StaticResource Primary}"/>
                    <Button x:Name="TgApply" Content="Применить"/>
                    <Button x:Name="TgRestart" Content="Перезапустить"/>
                    <Button x:Name="TgStop" Content="Остановить"/>
                    <Button x:Name="TgConnect" Content="Подключить Telegram"/>
                  </WrapPanel>
                </StackPanel>
              </Border>
            </UniformGrid>

            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Пинг сервисов" Style="{StaticResource Section}" Margin="0,0,0,8"/>
                <WrapPanel>
                  <Button x:Name="PingYouTube" Content="YouTube" MinWidth="95"/>
                  <Button x:Name="PingDiscord" Content="Discord" MinWidth="95"/>
                  <Button x:Name="PingTelegram" Content="Telegram" MinWidth="95"/>
                </WrapPanel>
                <TextBlock x:Name="PingResult" Style="{StaticResource MutedText}" Text="ICMP и HTTPS. Для Telegram также MTProto через запущенный прокси."/>
              </StackPanel>
            </Border>

            <TextBlock Text="Журнал" Style="{StaticResource Section}" Margin="0,0,0,6"/>
            <TextBox x:Name="Activity" Height="119" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                     Background="#0A0A0A" Foreground="#C9C9C9" BorderBrush="#2E2E2E" CaretBrush="#FFFFFF" Padding="10" FontSize="13" AutomationProperties.Name="Журнал операций"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Настройка обхода" Tag="&#xE72E;">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,9,4,7">
            <TextBlock Text="Настройка обхода" FontSize="29" FontWeight="Bold" Margin="0,0,0,14"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Фильтры zapret" Style="{StaticResource Section}" Margin="0,0,0,12"/>
                <UniformGrid Columns="2">
                  <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Game Filter" Style="{StaticResource MutedText}" Margin="0,0,0,5"/>
                    <ComboBox x:Name="GameFilter" AutomationProperties.Name="Game Filter"/>
                  </StackPanel>
                  <StackPanel Margin="8,0,0,0">
                    <TextBlock Text="IPSet" Style="{StaticResource MutedText}" Margin="0,0,0,5"/>
                    <ComboBox x:Name="IPSet" AutomationProperties.Name="IPSet"/>
                  </StackPanel>
                </UniformGrid>
                <WrapPanel>
                  <Button x:Name="SaveFilters" Content="Применить фильтры" Style="{StaticResource Primary}"/>
                  <Button x:Name="UpdateIPSet" Content="Обновить IPSet"/>
                  <Button x:Name="OpenLists" Content="Папка списков"/>
                </WrapPanel>
                <TextBlock x:Name="FilterFeedback" Style="{StaticResource MutedText}" Text="Если zapret запущен, он перезапустится с новыми настройками."/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Списки обхода и исключений" Style="{StaticResource Section}" Margin="0,0,0,10"/>
                <ComboBox x:Name="ListChoice" Width="280" HorizontalAlignment="Left" AutomationProperties.Name="Файл списка"/>
                <TextBox x:Name="ListEditor" Height="208" Padding="10" AcceptsReturn="True" AcceptsTab="False"
                         TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         Background="#0A0A0A" Foreground="#EDEDED" BorderBrush="#595959" CaretBrush="#FFFFFF"
                         FontFamily="Consolas" FontSize="14" AutomationProperties.Name="Редактор списка"/>
                <WrapPanel Margin="0,10,0,0">
                  <Button x:Name="LoadList" Content="Загрузить список"/>
                  <Button x:Name="SaveList" Content="Сохранить список" Style="{StaticResource Primary}"/>
                </WrapPanel>
                <TextBlock x:Name="ListFeedback" Style="{StaticResource MutedText}" Margin="0,0,0,10"
                           Text="Выбери файл и нажми «Загрузить список». Вводи по одной записи на строку."/>

                <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,6"><Run FontWeight="SemiBold" Foreground="#F5F5F5" Text="list-general-user.txt"/><Run Text="  — домены для обхода. Поддомены учитываются автоматически."/></TextBlock>
                <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,6"><Run FontWeight="SemiBold" Foreground="#F5F5F5" Text="list-exclude-user.txt"/><Run Text="  — домены-исключения. Например, домен в подсети из ipset-all.txt, который надо пропустить."/></TextBlock>
                <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,6"><Run FontWeight="SemiBold" Foreground="#F5F5F5" Text="ipset-all.txt"/><Run Text="  — IP и подсети. Обновление заменяет список данными Flowseal и сохраняет предыдущую версию рядом."/></TextBlock>
                <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,6"><Run FontWeight="SemiBold" Foreground="#F5F5F5" Text="ipset-exclude-user.txt"/><Run Text="  — исключения для IP и подсетей."/></TextBlock>
                <TextBlock Style="{StaticResource MutedText}" Text="Файлы *-user.txt создаются при первом запуске zapret или service.bat."/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Настройки" Tag="&#xE713;">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,9,4,7">
            <TextBlock Text="Настройки" FontSize="29" FontWeight="Bold" Margin="0,0,0,14"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
              <StackPanel>
                <CheckBox x:Name="AutoStart" Content="Автозапуск zapretgui" Foreground="#F5F5F5" FontSize="16" Padding="7,0,0,0"/>
                <TextBlock Style="{StaticResource MutedText}" Margin="22,7,0,0" Text="Открывать панель при входе в Windows. Установленные zapret и TG WS Proxy запустятся вместе с ней."/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <CheckBox x:Name="MinimizeToTray" Content="Убирать окно в трей" Foreground="#F5F5F5" FontSize="16" Padding="7,0,0,0"/>
                <TextBlock Style="{StaticResource MutedText}" Margin="22,7,0,0" Text="Кнопки «Свернуть» и «×» убирают окно в трей. Двойной щелчок по значку возвращает окно, а пункт «Выход» закрывает приложение."/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="Обновление приложения" Style="{StaticResource Section}" Margin="0,0,0,7"/>
                <TextBlock x:Name="InstalledAppVersion" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,11"
                           Text="Проверить версию на GitHub, скачать и установить обновление. Приложение откроется снова после установки."/>
                <Button x:Name="OpenAppUpdate" Content="Обновить"
                        Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0"/>
                <TextBlock Style="{StaticResource MutedText}" Margin="0,12,0,5"
                           Text="Для приватного репозитория сохрани токен GitHub с доступом Contents: Read-only. Пустое поле удаляет сохранённый токен."/>
                <WrapPanel>
                  <PasswordBox x:Name="GitHubToken" Width="290" Height="35" Margin="0,0,8,0"
                               Background="#141414" Foreground="#F5F5F5" BorderBrush="#4A4A4A"
                               Padding="8,5" AutomationProperties.Name="Токен GitHub"/>
                  <Button x:Name="SaveGitHubToken" Content="Сохранить токен"/>
                </WrapPanel>
              </StackPanel>
            </Border>
            <TextBlock x:Name="SettingsFeedback" Style="{StaticResource MutedText}" Margin="0,11,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <StackPanel Grid.Row="2">
      <ProgressBar x:Name="WorkProgress" Height="3" Visibility="Collapsed" Background="#2A2A2A" Foreground="#F2F2F2" BorderThickness="0"/>
      <TextBlock x:Name="Footer" Style="{StaticResource MutedText}" Text="Готовлю панель…" Margin="0,8,0,0"/>
    </StackPanel>
    </Grid>
  </Grid>
</Window>
