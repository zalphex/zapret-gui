<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <OutputType>WinExe</OutputType><AssemblyName>zapretgui</AssemblyName><RootNamespace>ZapretGui</RootNamespace>
    <StartupObject>Program</StartupObject><PlatformTarget>x64</PlatformTarget><Optimize>true</Optimize><OutputPath>bin\</OutputPath>
    <ApplicationIcon>Assets\zapretgui.ico</ApplicationIcon><ApplicationManifest>Windows\app.manifest</ApplicationManifest>
    <LangVersion>5</LangVersion><WarningLevel>4</WarningLevel><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System"/><Reference Include="System.Core"/><Reference Include="System.Drawing"/>
    <Reference Include="System.Windows.Forms"/><Reference Include="System.Web.Extensions"/><Reference Include="System.ServiceProcess"/>
    <Reference Include="Microsoft.CSharp"/><Reference Include="System.IO.Compression"/>
    <Reference Include="WindowsBase"/><Reference Include="PresentationCore"/><Reference Include="PresentationFramework"/>
    <Reference Include="WindowsFormsIntegration"/><Reference Include="System.Xaml"/><Reference Include="System.Xml"/>
    <Compile Include="Core\*.cs"/><Compile Include="Windows\*.cs"/><Compile Include="UI\*.cs"/>
    <EmbeddedResource Include="UI\Window.xaml"><LogicalName>Window.xaml</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="Assets\zapretgui.ico"><LogicalName>zapretgui.ico</LogicalName></EmbeddedResource>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets"/>
</Project>
